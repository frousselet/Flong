          }
        }
      }
    },
    "Sign in on the site's own page. Flong keeps the session in the keychain, never a password, and uses it only to fetch the articles of that site." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous sur la page du site lui-même. Flong garde la session dans le trousseau, jamais un mot de passe, et ne s'en sert que pour récupérer les articles de ce site."
