    "Written on" : {
      "comment" : "One thing a typed sentence was understood to ask for.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annotés"
          }
        }
      }
    },
    "You" : {
      "comment" : "Against the reader's own face, in the list of people in a shared collection.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous"
          }
        }
      }
    },
    "Your contributor code" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre code de contributeur"
          }
        }
      }
    },
    "Your iCloud could not be asked" : {
      "comment" : "The title of the alert shown when the zone could not be read : no account, or no network.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre iCloud n'a pas pu être interrogé"
          }
        }
      }
    },
    "Your iCloud no longer has these, so another device stopped following them. Removing one takes its articles with it, the ones you kept included, and cannot be undone.\n\n%@" : {
      "comment" : "The message of the alert listing the sources removed on another device. The argument is the list of their names, one per line.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre iCloud ne les détient plus : un autre appareil a cessé de les suivre. Retirer une source emporte ses articles, y compris ceux que vous avez gardés, et c'est définitif.\n\n%@"
          }
        }
      }
    },
    "Your name" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre nom"
          }
        }
      }
    },
    "Your own subjects" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos thématiques"
          }
        }
      }
    },
    "Your subscriptions, every article, everything you kept and every site you are signed in to, on this device and in your iCloud. This cannot be undone. Another device that still has them will put its own copy back." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos abonnements, tous les articles, tout ce que vous avez conservé et chaque site auquel vous êtes connecté, sur cet appareil et dans votre iCloud. Cette action est irréversible. Un autre appareil qui les possède encore en remettra sa propre copie."
          }
        }
      }
    },
    "Yours" : {
      "extractionState" : "stale",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le vôtre"
          }
        }
      }
    },
    "Yours to add and to remove. The model reaches for them as readily as the sections." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les vôtres, à ajouter et à retirer. Le modèle y recourt aussi volontiers qu'aux rubriques."
          }
        }
      }
    }
