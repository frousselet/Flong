      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos identifiants sont enregistrés dans le trousseau et partagés avec vos autres appareils via le trousseau iCloud."
          }
        }
      }
    },
    "iCloud Keychain refused the item, so they stay on this device.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le trousseau iCloud a refusé l'élément, ils restent donc sur cet appareil."
          }
        }
      }
    },
