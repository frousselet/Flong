          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qu'elle a signé a été purgé, ou n'est pas encore arrivé."
          }
        }
      }
    },
    "Where you are" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Où vous êtes"
          }
        }
      }
    },
    "Where you are could not be worked out. Search for your city instead." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de déterminer où vous êtes. Cherchez plutôt votre ville."
          }
        }
      }
    },
    "Which publisher it is grouped under, and where its icon is looked for. Leave it empty and it is grouped under the address of the feed itself." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’éditeur sous lequel elle est regroupée, et l’endroit où son icône est cherchée. Laissez le champ vide et elle est regroupée sous l’adresse du flux lui-même."
          }
        }
      }
    },
    "Who offered it" : {
      "localizations" : {
