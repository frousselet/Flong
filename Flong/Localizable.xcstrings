        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qu'elle cherche"
          }
        }
      }
    },
    "What named them has been purged, or has not arrived yet." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui les citait a été purgé, ou n'est pas encore arrivé."
          }
        }
      }
    },
    "What they signed has been purged, or has not arrived yet." : {
      "localizations" : {
