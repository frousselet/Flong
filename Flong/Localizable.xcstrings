    "Add a feed, import an OPML file, or see what other readers follow." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un flux, importez un fichier OPML, ou voyez ce que suivent les autres lecteurs."
