    },
    "The server did not return an authentication token.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n'a pas renvoyé de jeton d'authentification."
          }
        }
      }
    },
    "The server rejected this username or API password.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a refusé cet identifiant ou ce mot de passe d'API."
          }
        }
      }
    },
    "The server replied with error %lld.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a répondu une erreur %lld."
          }
        }
