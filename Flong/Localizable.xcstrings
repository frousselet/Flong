    "Session expired, please sign in again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Session expirée, reconnectez-vous."
          }
        }
      }
    },
    "The server address is not valid.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'adresse du serveur n'est pas valide."
          }
        }
