    "Answer in English. Write every word of your answer in English." : {
      "comment" : "Sent to the on-device model, in the reader's own language, to make it answer in that language",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réponds en français. Écris chaque mot de ta réponse en français."
          }
        }
      }
    },
    "Apple Intelligence is not available on this device. Stories keep the headline of their own article." : {
      "localizations" : {
        "fr" : {
