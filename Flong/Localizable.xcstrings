    "That town could not be read. Try another one." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette ville n'a pas pu être lue. Essayez-en une autre."
          }
        }
      }
    },
    "The address is kept in the keychain and never in the database. Tap the eye to read it, and edit it here like any other." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’adresse est conservée dans le trousseau et jamais dans la base. Touchez l’œil pour la lire, et modifiez-la ici comme n’importe quelle autre."
          }
        }
      }
    },
    "The address of a site you subscribe to, such as lemonde.fr." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'adresse d'un site auquel vous êtes abonné, par exemple lemonde.fr."
          }
        }
      }
    },
    "The articles stay where they are." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les articles restent où ils sont."
          }
        }
      }
    },
    "The headline and the line above were written on this device, from the articles below. Nothing was sent anywhere." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le titre et la ligne ci-dessus ont été écrits sur cet appareil, à partir des articles ci-dessous. Rien n'a été envoyé nulle part."
          }
        }
      }
    },
    "The model files stories under the subjects you have, and can write none of its own." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle classe les actualités sous les thématiques que vous avez, et n’en écrit aucune lui-même."
          }
        }
      }
    },
    "The sections every reader has. The model files each story under one or two of these, or of yours, and can write none of its own." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rubriques que tout lecteur connaît. Le modèle classe chaque actualité sous une ou deux d’entre elles, ou des vôtres, et n’en écrit aucune lui-même."
          }
        }
      }
    },
    "The sources stay where they are. Leave it empty to call it %@ again." : {
      "comment" : "The address of a publisher, such as lemonde.fr",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sources ne bougent pas. Laissez le champ vide pour l’appeler de nouveau %@."
          }
        }
      }
    },
    "The subscriptions could not be saved." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les abonnements n'ont pas pu être enregistrés."
          }
        }
      }
    },
    "The system model reads the page and sorts it into subjects. Saying more or less of one moves it, and everything under it, up or down the front page." : {
      "extractionState" : "stale",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle du système lit la page et la trie en thématiques. En demander plus ou moins déplace la thématique, et tout ce qu'elle couvre, vers le haut ou le bas de la une."
          }
        }
      }
    },
    "Theme" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thème"
          }
        }
      }
    },
    "They lose the collection. What they already filed stays in it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La personne perd la collection. Ce qu'elle y a déjà ajouté y reste."
          }
        }
      }
    },
    "This address could not be reached." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette adresse n'a pas pu être atteinte."
          }
        }
      }
    },
