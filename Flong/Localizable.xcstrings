    "Only readers somebody has brought in can add to the list. Give your code to a reader who is already in. Nothing of yours is published until then." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les lecteurs parrainés peuvent alimenter la liste. Donnez votre code à un lecteur qui en fait déjà partie. Rien de ce que vous suivez n’est publié d’ici là."
          }
        }
      }
    },
    "Peak day" : {
