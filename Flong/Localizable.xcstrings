    "The articles stay where they are." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les articles restent où ils sont."
          }
        }
      }
    },
    "The headline and the line above were written on this device, from the articles below. Nothing was sent anywhere." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le titre et la ligne ci-dessus ont été écrits sur cet appareil, à partir des articles ci-dessous. Rien n'a été envoyé nulle part."
          }
        }
      }
    },
    "The model files stories under the subjects you have, and reaches for yours as readily as its own." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle classe les fils sous les thématiques que vous avez, et prend les vôtres aussi volontiers que les siennes."
